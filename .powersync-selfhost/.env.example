# Copy this file to .env in the same directory before running
# `docker compose --env-file .env -p powersync-selfhost up -d`.
#
# Every value below is a fixed local-dev-only default (also visible in
# docker-compose.yaml's own `environment:` block for pg-storage) - there is
# nothing secret here to redact for a *local* stack. If you point this at
# anything other than your local Supabase project, change
# PG_DATABASE_HOSTNAME/PS_JWKS_URL to match your Supabase project's
# container names (see: `docker network ls` for
# `supabase_network_<project_id>`), and use real secrets for anything
# beyond local development.

# ==================== Supabase (source) ====================
# Supabase's own containers/network for project "slice-a-foundation"
# (see: docker network ls -> supabase_network_slice-a-foundation)
PG_DATABASE_HOSTNAME=supabase_db_slice-a-foundation
PG_DATABASE_NAME=postgres
PG_DATABASE_PORT=5432
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=postgres
PS_DATA_SOURCE_URI=postgresql://${PG_DATABASE_USER}:${PG_DATABASE_PASSWORD}@${PG_DATABASE_HOSTNAME}:${PG_DATABASE_PORT}/${PG_DATABASE_NAME}

# GoTrue JWKS endpoint, reachable via the Supabase Kong container on the shared network
PS_JWKS_URL=http://supabase_kong_slice-a-foundation:8000/auth/v1/.well-known/jwks.json

# ==================== PowerSync bucket storage (Postgres) ====================
# A separate Postgres instance (own container, own volume) used ONLY for
# PowerSync's internal sync-bucket storage. Kept fully separate from the
# Supabase database per the constraint not to touch the existing Supabase stack.
PS_STORAGE_SOURCE_URI=postgresql://powersync:powersync@pg-storage:5432/powersync_storage

# ==================== PowerSync service ====================
PS_PORT=8080
POWERSYNC_CONFIG_PATH=/config/service.yaml
