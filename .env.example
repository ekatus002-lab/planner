NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_POWERSYNC_URL=
# The single pre-provisioned account's email. Never shown in the UI - the
# sign-in screen is PIN-only; this email is the fixed identity that PIN
# authenticates as via Supabase's normal password grant.
